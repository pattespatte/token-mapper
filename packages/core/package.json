{
  "name": "@dtcg-mapper/core",
  "version": "0.0.0",
  "description": "Pure DTCG design-token pipeline: parse, validate, resolve, diff, export.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^4.1.10",
    "typescript": "~6.0.2",
    "jsdom": "^29.1.1"
  }
}
